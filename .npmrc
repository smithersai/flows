# pnpm 10+ verifies dependency state before `pnpm run`/`pnpm exec` and, on a
# mismatch, reinstalls — purging node_modules mid-command. A gate run must
# never mutate the install it is measuring (a CI install with
# --ignore-scripts hashes differently than a default install, so the
# "mismatch" is routine), and installation here is an explicit step: the
# workflow's install step locally, the tsflows install flow under the build
# system. Verification is therefore off.
verify-deps-before-run=false
