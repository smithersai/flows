{
  "name": "tsflows-rules",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Typed BUILD.ts rules and macros for tsflows",
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./*": {
        "types": "./dist/esm/*.d.ts",
        "import": "./dist/esm/*.js",
        "require": "./dist/cjs/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@smthrs/canonical-next": "0.1.0",
    "@smthrs/crypto-next": "0.1.0",
    "@smthrs/database-next": "0.1.0",
    "@smthrs/flow-next": "0.1.0",
    "@smthrs/keys-next": "0.1.0",
    "@smthrs/plan-next": "0.1.0",
    "@smthrs/tsflows-next": "0.1.0",
    "ignore": "7.0.6",
    "minimatch": "10.2.6"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "effect": "4.0.0-rc.108",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-unicorn": "61.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
