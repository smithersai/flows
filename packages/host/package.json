{
  "name": "@smithers/host",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Portable Effect host contracts and Node, browser, and test implementations for flows",
  "homepage": "https://github.com/smithersai/flows",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/flows.git",
    "directory": "packages/host"
  },
  "bugs": {
    "url": "https://github.com/smithersai/flows/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "host"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "host"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./test/contract": "./test/contract/HostContract.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "test/contract/HostContract.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./test/contract": "./test/contract/HostContract.ts",
      "./*": {
        "types": "./dist/esm/*.d.ts",
        "import": "./dist/esm/*.js",
        "require": "./dist/cjs/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "peerDependencies": {
    "@effect/platform-bun": "4.0.0-beta.102"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/language-service": "0.87.1",
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
