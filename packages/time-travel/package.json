{
  "name": "@flows/time-travel",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Durable replay, fork, and rewind primitives for flows",
  "homepage": "https://github.com/smithersai/flows",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/flows.git",
    "directory": "packages/time-travel"
  },
  "bugs": { "url": "https://github.com/smithersai/flows/issues" },
  "tags": ["typescript", "effect", "workflow", "time-travel"],
  "keywords": ["typescript", "effect", "workflow", "time-travel"],
  "engines": { "node": ">=22.19.0" },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@flows/database": "0.0.0",
    "@flows/engine-store": "0.0.0",
    "@flows/host": "0.0.0",
    "@flows/journal": "0.0.0",
    "@flows/keys": "0.0.0",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
