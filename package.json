    "esbuild": "0.28.1",
    "eslint-plugin-jsdoc": "64.1.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1",
    "vocs": "^2.8.5",
    "waku": "^1.0.0-beta.9"
