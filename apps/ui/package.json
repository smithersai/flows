{
	"name": "smithers-ui",
	"private": true,
	"version": "1.0.0",
	"description": "Smithers closed-alpha native app",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"start:canary": "SMITHERS_APP_URL=https://canary.smithers.sh electrobun dev",
		"hmr": "vite --port 5173",
		"web": "vite --port 5173",
		"build": "vite build",
		"serve:local": "vite build && bun x wrangler dev",
		"typecheck": "tsc --noEmit",
		"test": "bun test src",
		"test:e2e:web": "bun scripts/web-chat-e2e.ts",
		"test:e2e:web:context": "bun scripts/web-chat-context-e2e.ts",
		"test:e2e:web:shell": "bun scripts/web-chat-shell-e2e.ts",
		"test:e2e:worker": "bun scripts/worker-e2e.ts",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/inter": "5.3.0",
		"@journeyapps/wa-sqlite": "1.7.2",
		"@smthrs/canonical-next": "workspace:*",
		"@smthrs/capability-next": "workspace:*",
		"@smthrs/chain-next": "workspace:*",
		"@smthrs/core": "workspace:*",
		"@smthrs/crypto-next": "workspace:*",
		"@smthrs/database-next": "workspace:*",
		"@smthrs/jj-next": "workspace:*",
		"@smthrs/journal-next": "workspace:*",
		"@smthrs/kernel-next": "workspace:*",
		"@smthrs/memory": "workspace:*",
		"@smthrs/model": "workspace:*",
		"@smthrs/patterns": "workspace:*",
		"@smthrs/platform-browser-next": "workspace:*",
		"@smthrs/registry": "workspace:*",
		"@smthrs/ui": "0.33.0",
		"@standard-schema/spec": "1.1.0",
		"@tanstack/browser-db-sqlite-persistence": "0.2.9",
		"@tanstack/db": "0.6.17",
		"@tanstack/react-db": "0.1.95",
		"effect": "4.0.0-rc.108",
		"electrobun": "1.18.1",
		"lucide-react": "1.28.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"smithers-shared": "workspace:*",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.11.2",
		"@types/bun": "latest",
		"@types/d3-force": "3.0.10",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.185.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
