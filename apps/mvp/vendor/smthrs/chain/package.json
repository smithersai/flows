{
	"name": "@smthrs/chain",
	"type": "module",
	"version": "0.0.0",
	"license": "MIT",
	"description": "The Agent Chain spine: an append-only journal, keyed replayable calls, and the trampoline that runs model-authored flow scripts",
	"homepage": "https://github.com/smithersai/flows",
	"repository": {
		"type": "git",
		"url": "https://github.com/smithersai/flows.git",
		"directory": "packages/chain"
	},
	"bugs": {
		"url": "https://github.com/smithersai/flows/issues"
	},
	"tags": [
		"typescript",
		"effect",
		"chain",
		"harness",
		"durability"
	],
	"keywords": [
		"typescript",
		"effect",
		"chain",
		"harness",
		"durability"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"sideEffects": [],
	"exports": {
		"./package.json": "./package.json",
		".": "./src/index.ts",
		"./*": "./src/*.ts",
		"./internal/*": null,
		"./*/index": null
	},
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"dist/**/package.json",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			"./package.json": "./package.json",
			".": {
				"types": "./dist/esm/index.d.ts",
				"import": "./dist/esm/index.js",
				"require": "./dist/cjs/index.js"
			},
			"./*": {
				"types": "./dist/esm/*.d.ts",
				"import": "./dist/esm/*.js",
				"require": "./dist/cjs/*.js"
			},
			"./internal/*": null,
			"./*/index": null
		}
	},
	"scripts": {
		"lint": "eslint src --max-warnings=0 && dprint check",
		"format": "dprint fmt",
		"build": "node scripts/build.mjs",
		"check": "tsc -b tsconfig.json",
		"prompts": "node scripts/prompts.mjs",
		"circular": "node scripts/circular.mjs",
		"test": "vitest",
		"coverage": "vitest --coverage"
	},
	"dependencies": {
		"@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
		"@smthrs/capability": "file:../capability",
		"@smthrs/core": "file:../core",
		"@smthrs/memory": "file:../memory",
		"@smthrs/model": "file:../model",
		"@smthrs/registry": "file:../registry",
		"effect": "4.0.0-beta.102",
		"quickjs-emscripten-core": "0.32.0"
	}
}
