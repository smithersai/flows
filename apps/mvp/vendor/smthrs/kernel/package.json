{
	"name": "@smthrs/kernel",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Capability kernel: effect tiers, monotone capability sets, grant store, and permission-decorating layers over the Host services",
	"homepage": "https://github.com/smithersai/flows",
	"repository": {
		"type": "git",
		"url": "https://github.com/smithersai/flows.git",
		"directory": "packages/kernel"
	},
	"bugs": {
		"url": "https://github.com/smithersai/flows/issues"
	},
	"tags": [
		"typescript",
		"effect",
		"flow",
		"capabilities"
	],
	"keywords": [
		"typescript",
		"effect",
		"flow",
		"capabilities"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"sideEffects": [],
	"exports": {
		"./package.json": "./package.json",
		".": "./src/index.ts",
		"./test/contract": "./src/test/HostContract.ts",
		"./*": "./src/*.ts",
		"./internal/*": null,
		"./*/index": null
	},
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"dist/**/package.json",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			"./package.json": "./package.json",
			".": {
				"types": "./dist/esm/index.d.ts",
				"import": "./dist/esm/index.js",
				"require": "./dist/cjs/index.js"
			},
			"./test/contract": {
				"types": "./dist/esm/test/HostContract.d.ts",
				"import": "./dist/esm/test/HostContract.js",
				"require": "./dist/cjs/test/HostContract.js"
			},
			"./*": {
				"types": "./dist/esm/*.d.ts",
				"import": "./dist/esm/*.js",
				"require": "./dist/cjs/*.js"
			},
			"./internal/*": null,
			"./*/index": null
		}
	},
	"scripts": {
		"lint": "eslint src --max-warnings=0 && dprint check",
		"format": "dprint fmt",
		"build": "node scripts/build.mjs",
		"check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
		"circular": "node scripts/circular.mjs",
		"test": "vitest",
		"coverage": "vitest --coverage"
	},
	"dependencies": {
		"@smthrs/capability": "file:../capability",
		"@smthrs/jj": "file:../jj",
		"@smthrs/journal": "file:../journal",
		"@smthrs/platform-browser": "file:../platform-browser",
		"effect": "4.0.0-beta.102"
	},
	"peerDependencies": {
		"vitest": "4.1.9"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	}
}
