{
	"name": "@smthrs/database",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Thin Effect SQL client and SQLite write-retry service for flows",
	"homepage": "https://github.com/smithersai/flows",
	"repository": {
		"type": "git",
		"url": "https://github.com/smithersai/flows.git",
		"directory": "packages/database"
	},
	"bugs": {
		"url": "https://github.com/smithersai/flows/issues"
	},
	"tags": [
		"typescript",
		"effect",
		"sql",
		"sqlite"
	],
	"keywords": [
		"typescript",
		"effect",
		"sql",
		"sqlite"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"sideEffects": [],
	"exports": {
		"./package.json": "./package.json",
		".": "./src/index.ts",
		"./*": "./src/*.ts",
		"./internal/*": null,
		"./*/index": null
	},
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"dist/**/package.json",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			"./package.json": "./package.json",
			".": {
				"types": "./dist/esm/index.d.ts",
				"import": "./dist/esm/index.js",
				"require": "./dist/cjs/index.js"
			},
			"./*": {
				"types": "./dist/esm/*.d.ts",
				"import": "./dist/esm/*.js",
				"require": "./dist/cjs/*.js"
			},
			"./internal/*": null,
			"./*/index": null
		}
	},
	"scripts": {
		"lint": "eslint src --max-warnings=0 && dprint check",
		"format": "dprint fmt",
		"build": "node scripts/build.mjs",
		"check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
		"circular": "node scripts/circular.mjs",
		"test": "vitest",
		"coverage": "vitest --coverage"
	},
	"dependencies": {
		"@effect/sql-sqlite-node": "4.0.0-beta.102",
		"effect": "4.0.0-beta.102"
	}
}
