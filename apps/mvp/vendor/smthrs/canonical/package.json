{
	"name": "@smthrs/canonical",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Effect wrapper for RFC 8785 JSON canonicalization",
	"homepage": "https://github.com/smithersai/flows",
	"repository": {
		"type": "git",
		"url": "https://github.com/smithersai/flows.git",
		"directory": "packages/canonical"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"sideEffects": [],
	"exports": {
		"./package.json": "./package.json",
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"files": [
		"src/**/*.ts",
		"dist/**/*",
		"LICENSE",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			"./package.json": "./package.json",
			".": {
				"types": "./dist/esm/index.d.ts",
				"import": "./dist/esm/index.js",
				"require": "./dist/cjs/index.js"
			},
			"./*": {
				"types": "./dist/esm/*.d.ts",
				"import": "./dist/esm/*.js",
				"require": "./dist/cjs/*.js"
			}
		}
	},
	"scripts": {
		"lint": "eslint src --max-warnings=0 && dprint check",
		"format": "dprint fmt",
		"build": "node scripts/build.mjs",
		"check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
		"circular": "node scripts/circular.mjs",
		"test": "vitest",
		"coverage": "vitest --coverage"
	},
	"dependencies": {
		"effect": "4.0.0-beta.102"
	}
}
